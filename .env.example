# ====== 主模型 ======
# 支持任意 OpenAI 兼容端点。推荐使用国产模型（赛事鼓励，且成本低）。
#
# --- 方案 A：DeepSeek deepseek-flash（当前推荐，便宜，够用）---
# 端点：https://api.deepseek.com
# ⚠️ deepseek-flash 是推理模型，默认会消耗大量 thinking token ——
#    本项目已通过 client.ts 的 fetch 钩子自动加 thinking=disabled，
#    实测输出 token 降 70%、耗时减半。换用其他推理模型时记得核对这一点。
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
INTERVIEW_MODEL=deepseek-flash
ANALYSIS_MODEL=deepseek-flash
#
# --- 方案 B：智谱 GLM-4.7-Flash（免费，200K 上下文）---
# 端点：https://open.bigmodel.cn/api/paas/v4  （注意结尾 /v4 不能少）
# key 在 https://bigmodel.cn 控制台创建
# 注意：免费档限制为「并发 1」，适合单用户顺序调用；key 失效时会返回 401 code:1000，
#       该错误在两个平台端点下都会出现，可据此判断是账号侧问题而非配置写错
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# INTERVIEW_MODEL=glm-4.7-flash
# ANALYSIS_MODEL=glm-4.7-flash

# ====== 备用模型（可选）======
# 主模型调用失败时自动切换重试一次；不填 FALLBACK_API_KEY 则关闭备用链路
# 示例用的是 deepseek-flash（便宜够用）：
#   FALLBACK_BASE_URL=https://api.deepseek.com
#   FALLBACK_MODEL=deepseek-flash
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.deepseek.com/v1
FALLBACK_MODEL=deepseek-v4-pro

# deepseek-flash 默认先产 thinking token 再产答案（实测占 completion token 的 90%+）。
# 本项目的 AI 任务都是结构化输出，不需要中间推理 → 默认 disabled。
# 可选值同 DeepSeek API：enabled / disabled / adaptive
DEEPSEEK_THINKING=disabled

# ====== 成本计量单价（元 / 百万 token）======
# 留空则按 OPENAI_BASE_URL 自动判定：
#   智谱 bigmodel.cn（GLM-Flash 免费档）= 0
#   DeepSeek = 空闲时段 4.5 / 13.5（高峰时段约翻倍）
OPC_PRICE_INPUT_PER_MILLION=
OPC_PRICE_OUTPUT_PER_MILLION=

# ====== AI 调用治理（限流 / 预算 / 输出上限）======
# 每次 LLM 调用都要花钱，且大模型接口天然是滥用目标 —— 这三项是兜底闸门。

# 单次调用输出 token 上限。调用点未显式指定时自动补上，防止跑飞。
OPC_MAX_OUTPUT_TOKENS=4096

# 滑动窗口限流（每小时）。
# 会话维度查数据库，重启不丢；IP 维度为内存计数，阈值放宽些
# （同一出口 IP 可能对应多个人，比如校园网）。
OPC_RATE_LIMIT_PER_HOUR_SESSION=20
OPC_RATE_LIMIT_PER_HOUR_IP=60

# 当日累计 AI 花费上限（元）。超出后停止接单，次日 0 点自动恢复。
OPC_DAILY_BUDGET_CNY=5

# ====== 岗位数据远程热更新（可选）======
# 留空 = 关闭（默认用随代码发布的 data/roles/**）。
# 配置后：应用会定期拉取数据包并原子替换岗位/题库，**无需重启、无需发版**。
#
# 数据包由 `pnpm roles:bundle` 从 data/roles/** 打包生成，托管到任意静态地址即可。
# 拉取失败、超时、校验不通过 → 一律沿用当前数据，不影响使用。
OPC_ROLES_URL=
# 检查间隔（分钟）。默认 30；设为 0 等同关闭。
OPC_ROLES_REFRESH_MINUTES=30

# ====== 管理端令牌 ======
# 岗位管理接口的访问令牌，至少 12 位。未配置时管理接口整体关闭（默认安全）。
# 调用方式：Authorization: Bearer <token>  或  x-admin-token: <token>
ADMIN_TOKEN=

# ====== 数据库 ======
# SQLite 文件路径（默认项目根目录 interview.db）
DATABASE_URL=file:./interview.db

# ====== Clerk Auth（可选，公网部署时可为空） ======
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
